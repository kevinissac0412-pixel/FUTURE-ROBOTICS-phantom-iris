"scripts/validate_evidence.py": """#!/usr/bin/env python3
\"\"\"Minimal validator for PHANTOM IRIS evidence-record JSON files.\"\"\"
import json
import sys
from pathlib import Path

REQUIRED = {"evidence_id", "module", "status", "title", "source", "collected_at_utc", "method", "observation", "limitations", "next_step"}
MODULES = {"certificate-trust", "endpoint-malware-analysis", "authorization-testing"}
STATUSES = {"VERIFIED", "REPORTED", "HYPOTHESIS", "UNCONFIRMED"}

def main():
    if len(sys.argv) != 2:
        print("Usage: python scripts/validate_evidence.py <record.json>")
        return 2
    path = Path(sys.argv[1])
    try:
        record = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        print(f"ERROR: cannot read valid JSON: {exc}")
        return 2
    missing = sorted(REQUIRED - record.keys())
    errors = []
    if missing:
        errors.append("missing required fields: " + ", ".join(missing))
    if record.get("module") not in MODULES:
        errors.append("module must be one of: " + ", ".join(sorted(MODULES)))
    if record.get("status") not in STATUSES:
        errors.append("status must be one of: " + ", ".join(sorted(STATUSES)))
    if not errors:
        print(f"OK: {record['evidence_id']} ({record['module']}, {record['status']})")
        print("Note: schema validation does not verify the truth or provenance of a claim.")
        return 0
    for error in errors:
        print("ERROR:", error)
    return 1

if __name__ == "__main__":
    raise SystemExit(main())
"""
}
